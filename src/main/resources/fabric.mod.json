{
  "schemaVersion": 1,
  "id": "seedcracker_resilient",
  "version": "${version}",
  "name": "SeedCracker Resilient",
  "description": "Permission-based seed recovery that does not trust server-supplied seed metadata.",
  "authors": [
    "KaptainWutax",
    "19MisterX98",
    "SeedCracker Resilient contributors"
  ],
  "contact": {
    "homepage": "https://github.com/egarrr0808/seedcracker-resilient",
    "sources": "https://github.com/egarrr0808/seedcracker-resilient",
    "issues": "https://github.com/egarrr0808/seedcracker-resilient/issues"
  },
  "license": "MIT",
  "icon": "assets/seedcrackerx/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "kaptainwutax.seedcrackerX.SeedCracker"
    ],
    "modmenu": [
    ]
  },
  "mixins": [
    "seedcracker.mixins.json"
  ],
  "accessWidener": "seedcrackerx.aw",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=26.2 <26.3",
    "fabric-api-base": "*",
    "fabric-transitive-access-wideners-v1": "*",
    "fabric-command-api-v2": "*",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v0": "*",
    "fabric-resource-loader-v1": "*",
    "cloth-config": "*"
  },
  "breaks": {
    "seedcrackerx": "*"
  },
  "suggests": {
    "flamingo": "*",
    "modmenu": "*"
  }
}
